# Shared OpenRouter key — used by any configured client that has no override below.
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# Per-client overrides (optional). Env var prefix = client name from config.json,
# uppercased. Each client can independently override its api key, model, base_url,
# and timeout without touching code.

# Client "openai_gpt" (config.json -> clients.openai_gpt)
# OPENAI_GPT_API_KEY=
# OPENAI_GPT_MODEL=openai/gpt-4o-mini
# OPENAI_GPT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_GPT_TIMEOUT=120

# Client "anthropic_claude" (config.json -> clients.anthropic_claude)
# ANTHROPIC_CLAUDE_API_KEY=
# ANTHROPIC_CLAUDE_MODEL=anthropic/claude-3.5-sonnet
# ANTHROPIC_CLAUDE_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_CLAUDE_TIMEOUT=120