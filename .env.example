# Copy this file to .env and fill in your own values.
# .env itself is git-ignored — never commit real credentials.

# --- LLM (OpenRouter) ---
# Required: every LLM-powered pipeline/chat step needs this.
OPENROUTER_API_KEY=
# Optional fallback key, tried automatically if the primary is invalid,
# rate-limited, or out of credit.
OPENROUTER_API_KEY1=

# --- AWS credentials ---
# Required: both input sources (Cost Explorer, CloudWatch) and the dashboard's
# AWS target read live from your account — there is no local-file source.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# Cost allocation tag CostExplorerSource groups the "tag_cost" table by. Must
# already be activated as a cost allocation tag in the account's Billing
# console, or that one table just comes back empty.
COST_ALLOCATION_TAG_KEY=Project

# --- Real AWS write gate ---
# Real AWS reads (describe_instances, cost/usage, budgets) always run once
# credentials are present above. Real mutations (stop/resize/terminate/tag/
# budget) additionally require this — until set to 1, every write is logged
# as a dry run and never executed.
AWS_ALLOW_REAL_WRITES=0
# Extra allowlists so even a write-enabled run can't touch a resource outside
# these regions, or one missing this tag key. Empty = no restriction.
AWS_WRITE_ALLOWED_REGIONS=
AWS_WRITE_REQUIRE_TAG=
# Cap on a resize's *target* instance type — the only sizes a real resize is
# allowed to land on.
AWS_WRITE_ALLOWED_INSTANCE_TYPES=t2.nano,t2.micro,t2.medium,t3.nano,t3.micro

# --- RE-team gate ---
# Shared-secret header (X-RE-Token) required on stage/unstage/commit/rollback
# once set. Empty (default) leaves those endpoints open, for local/demo use.
RE_TEAM_TOKEN=

# --- Teams + actionable recommendations ---
# Teams Incoming Webhook URL the report card is pushed to. Empty = no push.
TEAMS_WEBHOOK_URL=
# Base URL the "Apply" buttons link back to. Swap for a tunnel/host URL when
# the loop must work from outside this machine.
PUBLIC_BASE_URL=http://127.0.0.1:8765
# Which executor runs when a recommendation is applied: "csv" (writes to
# outputs/applied/<run>/) or "aws" (calls the real AWS API). The dashboard
# always forces "aws" regardless of this value; only main.py's CLI reads it.
ACTION_BACKEND=csv

# --- Data storage (matches docker-compose.yml's services) ---
DATABASE_URL=postgresql://arrk:arrk@127.0.0.1:5432/arrk_docs_agent
REDIS_URL=redis://127.0.0.1:6379/0
