# AWS credentials for cost_explorer_export.py — copy this file to ".env"
# (same folder) and fill in real values. ".env" is a local secrets file:
# never commit it or send it anywhere; .env.aws.example is the safe-to-share
# template.
#
# Prefer a read-only IAM user/role scoped to just:
#   ce:GetCostAndUsage, ce:GetReservationUtilization, ce:GetDimensionValues,
#   budgets:DescribeBudgets, sts:GetCallerIdentity
#
# If you'd rather use a named profile from your real ~/.aws/credentials
# instead of this file, just don't create .env and pass --profile <name> to
# the script — leave every line below blank/absent in that case.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only needed for temporary credentials (an STS AssumeRole session, SSO,
# etc). Leave blank for a long-lived IAM user's access/secret key pair.
AWS_SESSION_TOKEN=

# Cost Explorer is a global endpoint but the SDK still needs a region to
# sign requests with — us-east-1 is the conventional choice regardless of
# which regions your actual spend is in.
AWS_DEFAULT_REGION=us-east-1
