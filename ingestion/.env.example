# Copy to .env and adjust for local docker-compose runs.
# docker-compose.yml reads these; unset vars fall back to the defaults below.

# Fernet key for encrypting staging output. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset in dev - docker-compose.yml mounts ./secret.key into the
# container, so a key generated on first run persists across restarts
# (touch an empty secret.key file first if it doesn't exist yet, so Docker
# doesn't mount it as a directory).
ENCRYPTION_KEY=

# Comma-separated AWS account IDs. Denylist always wins; a non-empty
# allowlist rejects every account not on it.
ACCOUNT_DENYLIST=999999999999
ACCOUNT_ALLOWLIST=

RATE_LIMIT_PER_MINUTE=5
